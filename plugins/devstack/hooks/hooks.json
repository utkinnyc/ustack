{
  "description": "Load the devstack rules into every session, and again after /clear and compaction.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/RULES.md\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
