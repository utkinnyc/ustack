{
  "description": "Load the devstack rules into every session (again after /clear and compaction) and into every subagent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/RULES.md\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-rules.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
